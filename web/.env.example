DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Django'nun kendi tabloları (auth/session/admin). migrate SADECE buraya yazar.
# Raspberry Pi'deki ortak geliştirme kopyasına bağlanmak için iki HOST değerini
# 100.64.0.7 (veya MagicDNS çalışıyorsa rpi) yap. Pi'deki gerçek parola Git'e
# yazılmaz; yetkili cihazlar arasında güvenli şekilde paylaşılır.
# Yerel ve Pi veritabanlarında aynı anda değişiklik yapıp dump'ları birleştirme.
#
WEB_DB_HOST=localhost
WEB_DB_PORT=5433
WEB_DB_NAME=metaks_web
WEB_DB_USER=depo_admin
WEB_DB_PASSWORD=change-me

# Paylaşımlı METAKS verisi. Salt-okunur/unmanaged; buraya ASLA migrate çalıştırılmaz.
METAKS_DB_HOST=localhost
METAKS_DB_PORT=5433
METAKS_DB_NAME=depo_sistemi
METAKS_DB_USER=depo_admin
METAKS_DB_PASSWORD=change-me

GORSEL_SUNUCU_BASE_URL=http://localhost:8083/urun-gorselleri/

# Pi veritabanı kullanılıyorsa:
# GORSEL_SUNUCU_BASE_URL=http://100.64.0.7:8083/urun-gorselleri/
